# ==========================================
# AI Loan Advisory Agent Configuration
# ==========================================

# LLM Provider Configuration ("ollama", "openai", "bedrock")
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI Configuration (Optional - required if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# AWS Bedrock Configuration (Optional - required if LLM_PROVIDER=bedrock or EMBEDDING_PROVIDER=bedrock)
AWS_REGION=us-east-1

# Cohere Configuration (Optional - required if EMBEDDING_PROVIDER=cohere)
COHERE_API_KEY=

# Embedding Provider Configuration ("ollama", "openai", "bedrock", "cohere")
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:latest

# Vector DB Provider ("chroma" or "pinecone")
VECTOR_DB_PROVIDER=chroma

# Pinecone Managed Vector DB Configuration (Optional - required if VECTOR_DB_PROVIDER=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=loan-policies

# Production Database (Optional - defaults to local SQLite if empty)
# Requires: pip install langgraph-checkpoint-postgres psycopg psycopg-pool
POSTGRES_URI=postgresql://user:password@localhost:5432/loan_advisory

# Authentication & Security
# Change this secret key in production!
JWT_SECRET_KEY=super-secret-development-key-change-in-prod

# Vector DB & RAG Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=5
